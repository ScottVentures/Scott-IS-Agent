# Copy to .env and fill in. Everything works in mock mode with no keys.
PORT=3000

# Claude planner (optional; falls back to a built-in planner)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Budget for each job, in USD
JOB_BUDGET_USD=0.50

# Payments: "mock" now, "metal" once Metal testnet access arrives
PAYMENT_MODE=mock
METAL_RPC_URL=
METAL_WALLET_PRIVATE_KEY=

# Airwallex sandbox: "mock" now, "sandbox" once you have keys
AIRWALLEX_MODE=mock
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
